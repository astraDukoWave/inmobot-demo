# Copia este archivo a .env y llena los valores. Nunca subas .env al repo.
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_THINKING_LEVEL=low
# Pendiente de validación real:
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5
ADMIN_TOKEN=
# Número de WhatsApp del asesor, solo dígitos con código de país (ej. 52 + 10 dígitos)
WHATSAPP_NUMBER=
DAILY_TOKEN_BUDGET=1000000
TRUST_PROXY=false
